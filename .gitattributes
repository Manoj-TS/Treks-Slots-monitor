# Force LF everywhere. Without this, a Windows checkout (core.autocrlf=true)
# gives start.sh and the nginx confs CRLF endings, and the VPS fails with:
#   bash: ./start.sh: /usr/bin/env: bash^M: No such file or directory
* text=auto eol=lf
*.sh   text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.png binary
