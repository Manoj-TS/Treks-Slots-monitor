# Copy to .env and edit before running start.sh:
#   cp .env.example .env

DOMAIN=aranyavihaara.org
EMAIL=you@example.com

# Loopback port the container publishes; the host nginx proxies to it.
# Change only if 5020 is taken by another project on the box.
APP_PORT=5020

# Postgres. Leave unset to run on the legacy JSON files instead (the app
# degrades to them automatically if the database is unreachable).
# DATABASE_URL=postgresql://aranya_app:PASSWORD@acube-db-1:5432/aranya
