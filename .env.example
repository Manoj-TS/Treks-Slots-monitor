# Copy to .env and edit before running start.sh:
#   cp .env.example .env

DOMAIN=aranyavihaara.org
EMAIL=you@example.com

# Loopback port the container publishes; the host nginx proxies to it.
# Change only if 5020 is taken by another project on the box.
APP_PORT=5020

# Postgres. Leave unset to run on the legacy JSON files instead (the app
# degrades to them automatically if the database is unreachable).
# DATABASE_URL=postgresql://aranya_app:PASSWORD@acube-db-1:5432/aranya

# ── Portal politeness ─────────────────────────────────────────────────────── #
# Hard ceiling on outbound requests to the government portal, shared by the
# background sweeper, the calendar view and the "Refresh now" button. Nothing
# can exceed it — more customers make a full pass take longer, not hit harder.
# SWEEP_RPS=3.0
#
# How stale each kind of cell may get, in seconds. Open slots use the
# operator-set interval in /admin instead, since that is the only data that
# actually moves. Sold-out and unreleased dates are polled slowly because their
# answers cannot change until the next daily release.
# SOLD_OUT_INTERVAL=1800
# UNRELEASED_INTERVAL=1800
#
# "Refresh now": per-user cooldown, and the most cells one click may jump the
# queue with (so one big board can't monopolise the rate budget).
# FORCE_REFRESH_COOLDOWN=120
# MAX_FORCE_CELLS=120
