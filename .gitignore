# ── Virtual environments ──
venv/
.venv/
env/
ENV/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ── Secrets / config (contains login credentials) ──
config.yaml

# ── Runtime artifacts ──
session_cookies.json
previous_booking_ids.txt
pay.html
summaryblade_response.html
*.pdf

# ── Local dev runtime state (a plain `python monitor.py` writes these to the
#    repo root; the Docker deploy writes the same files under ./data/ instead) ──
favourites.json
watchlist.json
trek_configs.json
dashboard_settings.json

# ── Docker deployment runtime state — never commit; live containers rewrite
#    these constantly, and committing them would make every VPS `git pull`
#    conflict with a file the running app owns ──
data/
.env

# ── IDE / OS ──
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log